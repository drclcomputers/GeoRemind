          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GeoRemind 用户"
          }
        }
      }
    },
    "Reminders stay on this device. Sign in to sync across devices, share with groups, and recover your pins if you switch devices.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder-ele rămân pe dispozitiv. Autentifică-te ca să sincronizezi, să folosești grupuri și să-ți recuperezi pinurile pe alt telefon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels restent sur cet appareil. Connecte-toi pour synchroniser, partager en groupe et récupérer tes épingles ailleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen bleiben auf diesem Gerät. Melde dich an für Sync, Gruppen und Wiederherstellung auf einem anderen Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se quedan en este dispositivo. Inicia sesión para sincronizar, usar grupos y recuperar pines en otro aparato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria restano su questo dispositivo. Accedi per sincronizzare, usare i gruppi e recuperare i pin su un altro telefono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes ficam neste aparelho. Inicia sessão para sincronizar, usar grupos e recuperar pins noutro dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia zostają na tym urządzeniu. Zaloguj się, aby synchronizować, używać grup i odzyskać pinezki na innym sprzęcie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen blijven op dit apparaat. Log in om te synchroniseren, groepen te gebruiken en spelden op een ander toestel terug te krijgen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування лишаються на пристрої. Увійди, щоб синхронізувати, користуватися групами й відновити піни на іншому телефоні."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők ezen az eszközön maradnak. Jelentkezz be a szinkronhoz, a csoportokhoz, és hogy másik készüléken is meglegyenek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar bu cihazda kalır. Senkron, gruplar ve başka telefonda pinleri kurtarmak için giriş yap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはこの端末に残ります。同期、グループ、機種変更時の復元にはサインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒只留在这台设备上。登录后可同步、使用群组，并在换机时找回图钉。"
          }
        }
      }
    },
    "I understand my reminders, groups and photo will be permanently deleted.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțeleg că reminder-ele, grupurile și poza vor fi șterse definitiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que mes rappels, groupes et photo seront définitivement supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass Erinnerungen, Gruppen und Foto endgültig gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que mis recordatorios, grupos y foto se eliminarán para siempre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capisco che promemoria, gruppi e foto verranno eliminati per sempre."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compreendo que os lembretes, grupos e foto serão apagados de vez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, że przypomnienia, grupy i zdjęcie zostaną trwale usunięte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat herinneringen, groepen en foto definitief worden verwijderd."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розумію, що нагадування, групи й фото буде видалено назавжди."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értem, hogy az emlékeztetők, csoportok és a fotó végleg törlődnek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılarımın, gruplarımın ve fotoğrafımın kalıcı silineceğini anlıyorum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー、グループ、写真が完全に削除されることを理解しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解提醒、群组和头像将被永久删除。"
          }
        }
      }
    },
