    "Confirms it's you, then deletes the account.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmă că ești tu, apoi șterge contul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que c'est toi, puis supprime le compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt, dass du es bist, und löscht das Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que eres tú y luego borra la cuenta."
          }
        },
