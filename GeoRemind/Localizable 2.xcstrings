    "If you signed in with Google or Facebook, confirm with the same provider. No email is sent.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă te-ai autentificat cu Google sau Facebook, confirmă cu același. Nu se trimite email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu t'es connecté avec Google ou Facebook, confirme avec le même. Aucun e-mail n'est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dich mit Google oder Facebook angemeldet hast, bestätige mit demselben Anbieter. Es wird keine E-Mail gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si entraste con Google o Facebook, confirma con el mismo. No se envía correo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sei entrato con Google o Facebook, conferma con lo stesso. Non viene inviata alcuna email."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entraste com Google ou Facebook, confirma com o mesmo. Não é enviado e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli logowałeś się przez Google lub Facebook, potwierdź tym samym. E-mail nie jest wysyłany."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je inlogde met Google of Facebook, bevestig met dezelfde. Er wordt geen e-mail gestuurd."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо входив через Google або Facebook, підтвердь тим самим. Лист не надсилається."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha Google-lal vagy Facebookkal léptél be, ugyanazzal erősítsd meg. Nem megy e-mail."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google veya Facebook ile girdiysen aynı sağlayıcıyla doğrula. E-posta gönderilmez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google / Facebook で入った場合は同じ方法で確認。メールは送りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若用 Google 或 Facebook 登录，请用同一方式确认。不会发邮件。"
          }
        }
      }
    },
