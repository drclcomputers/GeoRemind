    "This permanently deletes your reminders, groups, photo and login.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge definitiv reminder-ele, grupurile, poza și autentificarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tes rappels, groupes, photo et connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht Erinnerungen, Gruppen, Foto und Anmeldung endgültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra para siempre recordatorios, grupos, foto e inicio de sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina per sempre promemoria, gruppi, foto e accesso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apaga de vez lembretes, grupos, foto e início de sessão."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usuwa przypomnienia, grupy, zdjęcie i logowanie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert herinneringen, groepen, foto en login definitief."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видаляє нагадування, групи, фото й вхід."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Végleg törli az emlékeztetőket, csoportokat, fotót és bejelentkezést."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar, gruplar, foto ve giriş kalıcı silinir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー、グループ、写真、ログインが完全に削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除提醒、群组、头像和登录。"
          }
        }
      }
    },
