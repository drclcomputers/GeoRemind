    "Share the code. People type it in Profile to join. Codes expire after 7 days. Swipe a code to revoke it.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie codul. Se introduce în Profil. Expiră în 7 zile. Swipe ca să-l anulezi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage le code. On le tape dans Profil. Il expire après 7 jours. Balaye pour le révoquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code teilen. Eingabe unter Profil. Läuft nach 7 Tagen ab. Wischen zum Widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el código. Se escribe en Perfil. Caduca a los 7 días. Desliza para revocar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il codice. Si inserisce in Profilo. Scade dopo 7 giorni. Scorri per revocare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha o código. Escreve-se em Perfil. Expira em 7 dias. Desliza para revogar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij kod. Wpisu je się w Profilu. Wygasa po 7 dniach. Przesuń, aby unieważnić."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel de code. Typ hem in Profiel. Verloopt na 7 dagen. Veeg om in te trekken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділися кодом. Вводять у Профілі. Минає за 7 днів. Свайп — відкликати."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd meg a kódot. A Profilban kell beírni. 7 nap múlva lejár. Húzd el a visszavonáshoz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu paylaş. Profil'de yazılır. 7 günde dolar. İptal için kaydır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを共有。プロフィールで入力。7日で失効。スワイプで取り消し。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享邀请码。在个人资料里输入即可加入。7 天后过期。滑动可撤销。"
          }
        }
      }
    },
