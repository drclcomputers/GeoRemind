    "An account with this email already exists. Try signing in.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există deja un cont cu emailul ăsta. Încearcă să te autentifici."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cet e-mail. Essaie de te connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto mit dieser E-Mail existiert bereits. Bitte anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con este correo. Prueba a iniciar sesión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un account con questa email. Prova ad accedere."
          }
