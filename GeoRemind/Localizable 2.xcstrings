    "Password is too weak. Use 8+ characters with upper, lower, a number and a symbol.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola e prea slabă. Minim 8 caractere, majusculă, minusculă, cifră și simbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe trop faible. 8 caractères min., majuscule, minuscule, chiffre et symbole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort zu schwach. Mindestens 8 Zeichen mit Groß-, Kleinbuchstaben, Zahl und Sonderzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña demasiado débil. 8+ caracteres con mayúscula, minúscula, número y símbolo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Password troppo debole. Almeno 8 caratteri con maiuscola, minuscola, numero e simbolo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavra-passe fraca demais. 8+ caracteres com maiúscula, minúscula, número e símbolo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło za słabe. Min. 8 znaków, wielka i mała litera, cyfra i symbol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachtwoord te zwak. Minimaal 8 tekens met hoofdletter, kleine letter, cijfer en symbool."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль заслабкий. Від 8 символів: велика, мала літера, цифра і символ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl gyenge jelszó. Legalább 8 karakter, nagy- és kisbetű, szám és szimbólum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifre çok zayıf. En az 8 karakter, büyük/küçük harf, rakam ve sembol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが弱すぎます。8文字以上、大文字・小文字・数字・記号を含めて。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码太弱。至少 8 位，含大小写、数字和符号。"
          }
        }
      }
    },
