    "Only 20 active reminders can be monitored in the background. You have %lld active.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar 20 de remindere active pot fi monitorizate în fundal. Ai %lld active."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls 20 rappels actifs sont surveillés en arrière-plan. Tu en as %lld d'actifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur 20 aktive Erinnerungen werden im Hintergrund überwacht. Du hast %lld aktive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se vigilan 20 recordatorios activos en segundo plano. Tienes %lld activos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo 20 promemoria attivi sono monitorati in background. Ne hai %lld attivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só 20 lembretes ativos são vigiados em segundo plano. Tens %lld ativos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko 20 aktywnych przypomnień jest monitorowanych w tle. Masz %lld aktywnych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechts 20 actieve herinneringen worden op de achtergrond bewaakt. Je hebt er %lld actief."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У фоні моніторяться лише 20 активних нагадувань. У тебе %lld активних."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak 20 aktív emlékeztetőt figyel a rendszer a háttérben. %lld aktív van."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda yalnızca 20 aktif hatırlatıcı izlenir. %lld aktifin var."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでは有効なリマインダーは20件までです。現在 %lld 件が有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台最多监控 20 个有效提醒。你当前有 %lld 个。"
          }
        }
      }
    },
    "Location access is off. Reminders can't be shown or triggered.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locația e oprită. Reminder-ele nu pot fi afișate sau declanșate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée. Les rappels ne peuvent pas s'afficher ni se déclencher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ortungszugriff. Erinnerungen können nicht angezeigt oder ausgelöst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Los recordatorios no pueden mostrarse ni activarse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla posizione disattivato. I promemoria non possono essere mostrati o attivati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desligado. Os lembretes não podem ser mostrados nem disparados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do lokalizacji. Przypomnienia nie mogą być wyświetlane ani uruchamiane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot locatie. Herinneringen kunnen niet worden getoond of geactiveerd."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до розташування. Нагадування не можна показати чи запустити."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyhozzáférés ki van kapcsolva. Az emlékeztetők nem jeleníthetők meg és nem indíthatók."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum kapalı. Hatırlatıcılar gösterilemez veya tetiklenemez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報オフ。リマインダーを表示・発動できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启定位。无法显示或触发提醒。"
          }
        }
      }
    },
