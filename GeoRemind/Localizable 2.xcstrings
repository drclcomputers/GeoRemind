    "Notifications are off. You won't be alerted when you arrive.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt oprite. Nu vei fi anunțat când ajungi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Tu ne seras pas prévenu à l'arrivée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen aus. Du wirst bei der Ankunft nicht benachrichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. No te avisarán al llegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifiche disattivate. Non sarai avvisato all'arrivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas. Não serás avisado ao chegar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Nie dostaniesz alertu po przyjściu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit. Je wordt niet gewaarschuwd bij aankomst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено. Тебе не попередять, коли прибудеш."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva. Érkezéskor nem kapsz jelet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Vardığında uyarılmazsın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知オフ。到着しても知らせません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。到达时不会提醒你。"
          }
        }
      }
    },
    "Allow \"Always\" location to get reminders in the background.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite locație „Întotdeauna” ca să primești remindere în fundal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise la localisation « Toujours » pour les rappels en arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Ortung „Immer“, um Erinnerungen im Hintergrund zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ubicación «Siempre» para recordatorios en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti posizione «Sempre» per i promemoria in background."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite localização «Sempre» para lembretes em segundo plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na lokalizację „Zawsze”, aby dostawać przypomnienia w tle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta locatie «Altijd» toe voor herinneringen op de achtergrond."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь розташування «Завжди», щоб отримувати нагадування у фоні."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a «Mindig» helyhozzáférést a háttérbeli emlékeztetőkhöz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan hatırlatıcıları için Konum «Her Zaman» izni ver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド通知には位置情報「常に」が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许「始终」定位，以便在后台收到提醒。"
          }
        }
      }
    },
