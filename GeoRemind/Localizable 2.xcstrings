    "Only you will see this reminder.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar tu vezi reminder-ul ăsta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toi seul verras ce rappel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du siehst diese Erinnerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú verás este recordatorio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu vedrai questo promemoria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só tu vês este lembrete."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko ty zobaczysz to przypomnienie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen jij ziet deze herinnering."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ти бачиш це нагадування."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak te látod ezt az emlékeztetőt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hatırlatıcıyı yalnızca sen görürsün."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリマインダーは自分だけに表示されます。"
