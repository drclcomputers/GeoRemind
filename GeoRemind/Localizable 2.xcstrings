    "System uses the iPhone language. You can also change it in Settings → GeoRemind.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système utilise la langue de l'iPhone. Tu peux aussi la changer dans Réglages → GeoRemind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System nutzt die iPhone-Sprache. Du kannst sie auch unter Einstellungen → GeoRemind ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema usa el idioma del iPhone. También puedes cambiarlo en Ajustes → GeoRemind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema usa la lingua dell'iPhone. Puoi cambiarla anche in Impostazioni → GeoRemind."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema usa o idioma do iPhone. Também podes mudar em Definições → GeoRemind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System używa języka iPhone'a. Możesz też zmienić go w Ustawieniach → GeoRemind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeem gebruikt de iPhone-taal. Je kunt die ook wijzigen in Instellingen → GeoRemind."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Система бере мову iPhone. Можна змінити в Налаштуваннях → GeoRemind."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rendszer az iPhone nyelvét használja. A Beállítások → GeoRemind menüben is válthatsz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem iPhone dilini kullanır. Ayarlar → GeoRemind içinden de değiştirebilirsin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは iPhone の言語です。設定 → GeoRemind でも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统使用 iPhone 语言。也可在设置 → GeoRemind 中更改。"
          }
        }
      }
    },
