    "Reminders stay on this iPhone. Sign in to sync and use groups.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder-ele rămân pe iPhone. Autentifică-te pentru sync și grupuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels restent sur cet iPhone. Connecte-toi pour synchroniser et utiliser les groupes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen bleiben auf diesem iPhone. Melde dich an für Sync und Gruppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se quedan en este iPhone. Inicia sesión para sincronizar y usar grupos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria restano su questo iPhone. Accedi per sincronizzare e usare i gruppi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes ficam neste iPhone. Inicia sessão para sincronizar e usar grupos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia zostają na tym iPhonie. Zaloguj się, aby synchronizować i używać grup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen blijven op deze iPhone. Log in om te synchroniseren en groepen te gebruiken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування лишаються на цьому iPhone. Увійди для синхронізації та груп."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők ezen az iPhone-on maradnak. Jelentkezz be a szinkronhoz és a csoportokhoz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar bu iPhone'da kalır. Senkron ve gruplar için giriş yap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはこの iPhone にのみ保存されます。同期とグループにはサインインしてください。"
          }
        },
        "zh-Hans": {
