    "Never forget again": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Să nu mai uiți"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie plus jamais"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wieder vergessen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No vuelvas a olvidar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare più"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não voltes a esquecer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy więcej nie zapomnij"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nooit meer vergeten"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не забувай"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Soha többé ne felejts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir daha unutma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう忘れない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再忘记"
          }
        }
      }
    },
    "Set a reminder for a place, and GeoRemind will notify you the moment you get there.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune un reminder pe un loc, iar GeoRemind te anunță când ajungi acolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose un rappel sur un lieu, GeoRemind t'avertit dès que tu y arrives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze eine Erinnerung für einen Ort – GeoRemind benachrichtigt dich, sobald du ankommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un recordatorio en un lugar y GeoRemind te avisa al llegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un promemoria su un posto e GeoRemind ti avvisa appena arrivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe um lembrete num sítio e o GeoRemind avisa-te quando chegares."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw przypomnienie na miejscu, a GeoRemind powiadomi cię, gdy tam dotrzesz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een herinnering op een plek, GeoRemind waarschuwt je zodra je aankomt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постав нагадування на місце — GeoRemind сповістить, щойно прибудеш."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél emlékeztetőt egy helyre, a GeoRemind szól, amint odaérsz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yere hatırlatıcı koy, varınca GeoRemind haber verir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所にリマインダーを置くと、着いた瞬間に GeoRemind が知らせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给一个地点设提醒，一到那儿 GeoRemind 就会通知你。"
          }
        }
      }
    },
