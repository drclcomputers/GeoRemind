    "Link Google or Facebook while signed in so the same profile and photo are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe Google oder Facebook angemeldet, damit Profil und Foto bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula Google o Facebook con la sesión iniciada para conservar perfil y foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie Google ou Facebook une fois connecté pour garder le même profil et la même photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google vagy Facebook összekapcsolása bejelentkezve, hogy a profil és a fotó megmaradjon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega Google o Facebook da autenticato per tenere profilo e foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン中に Google / Facebook を連携すると、同じプロフィールと写真が残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel Google of Facebook terwijl je bent ingelogd zodat profiel en foto blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz Google lub Facebook po zalogowaniu, aby zachować profil i zdjęcie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga o Google ou Facebook com sessão iniciada para manter perfil e foto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leagă Google sau Facebook cât ești autentificat ca să păstrezi același profil și poză."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ve foto kalsın diye girişliyken Google veya Facebook bağla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
