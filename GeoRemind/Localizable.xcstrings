    "Set a reminder for a place, and GeoRemind will notify you the moment you get there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze eine Erinnerung für einen Ort – GeoRemind benachrichtigt dich, sobald du ankommst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un recordatorio en un lugar y GeoRemind te avisa al llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose un rappel sur un lieu, GeoRemind t'avertit dès que tu y arrives."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegyél emlékeztetőt egy helyre, a GeoRemind szól, amint odaérsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un promemoria su un posto e GeoRemind ti avvisa appena arrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所にリマインダーを置くと、着いた瞬間に GeoRemind が知らせます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een herinnering op een plek, GeoRemind waarschuwt je zodra je aankomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw przypomnienie na miejscu, a GeoRemind powiadomi cię, gdy tam dotrzesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põe um lembrete num sítio e o GeoRemind avisa-te quando chegares."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune un reminder pe un loc, iar GeoRemind te anunță când ajungi acolo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yere hatırlatıcı koy, varınca GeoRemind haber verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постав нагадування на місце — GeoRemind сповістить, щойно прибудеш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给一个地点设提醒，一到那儿 GeoRemind 就会通知你。"
          }
        }
      }
    },
