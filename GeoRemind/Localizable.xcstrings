    "I understand my reminders, groups and photo will be permanently deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, dass Erinnerungen, Gruppen und Foto endgültig gelöscht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que mis recordatorios, grupos y foto se eliminarán para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que mes rappels, groupes et photo seront définitivement supprimés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értem, hogy az emlékeztetők, csoportok és a fotó végleg törlődnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capisco che promemoria, gruppi e foto verranno eliminati per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダー、グループ、写真が完全に削除されることを理解しています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik begrijp dat herinneringen, groepen en foto definitief worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozumiem, że przypomnienia, grupy i zdjęcie zostaną trwale usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compreendo que os lembretes, grupos e foto serão apagados de vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înțeleg că reminder-ele, grupurile și poza vor fi șterse definitiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatıcılarımın, gruplarımın ve fotoğrafımın kalıcı silineceğini anlıyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розумію, що нагадування, групи й фото буде видалено назавжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我了解提醒、群组和头像将被永久删除。"
          }
        }
      }
    },
    "If you signed in with Google or Facebook, confirm with the same provider. No email is sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich mit Google oder Facebook angemeldet hast, bestätige mit demselben Anbieter. Es wird keine E-Mail gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si entraste con Google o Facebook, confirma con el mismo. No se envía correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu t'es connecté avec Google ou Facebook, confirme avec le même. Aucun e-mail n'est envoyé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha Google-lal vagy Facebookkal léptél be, ugyanazzal erősítsd meg. Nem megy e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sei entrato con Google o Facebook, conferma con lo stesso. Non viene inviata alcuna email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google / Facebook で入った場合は同じ方法で確認。メールは送りません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je inlogde met Google of Facebook, bevestig met dezelfde. Er wordt geen e-mail gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli logowałeś się przez Google lub Facebook, potwierdź tym samym. E-mail nie jest wysyłany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se entraste com Google ou Facebook, confirma com o mesmo. Não é enviado e-mail."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă te-ai autentificat cu Google sau Facebook, confirmă cu același. Nu se trimite email."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
